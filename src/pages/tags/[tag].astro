---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../consts';
import { withBase } from '../../lib/url';
import { readingMinutes } from '../../lib/reading';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(post);
    }
  }
  return [...tagMap.entries()].map(([tag, tagPosts]) => ({
    params: { tag },
    props: {
      tag,
      posts: tagPosts.sort(
        (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
      ),
    },
  }));
}

const { tag, posts } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(withBase('/'), Astro.site).href;

// 이 태그가 붙은 글을 ItemList로 노출(홈과 동일 패턴) — 검색엔진이
// 허브 페이지가 어떤 글을 묶는지 구조로 이해. 최신순, position 1부터.
const listItems = posts.map((post, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  url: new URL(withBase(`/posts/${post.id}/`), Astro.site).href,
  name: post.data.title,
}));

// CollectionPage + ItemList + BreadcrumbList (@graph)
// — 검색결과 경로(빵부스러기) 표시 + 허브가 묶는 글 목록 노출
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `#${tag} — ${SITE_NAME}`,
      description: `${SITE_NAME}의 "${tag}" 태그 글 목록`,
      url: canonical.href,
      inLanguage: 'ko-KR',
      publisher: { '@type': 'Organization', name: SITE_NAME },
    },
    {
      '@type': 'ItemList',
      name: `#${tag} 글 목록`,
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: listItems.length,
      itemListElement: listItems,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: siteUrl },
        { '@type': 'ListItem', position: 2, name: `#${tag}`, item: canonical.href },
      ],
    },
  ],
};
---

<BaseLayout
  title={`#${tag} — 옳은경제`}
  description={`옳은경제에서 "${tag}" 태그가 붙은 글을 모았습니다. 어려운 경제를 쉽고 정확하게 정리합니다.`}
  {/* 글 1편짜리 thin 태그는 색인 제외(링크는 따라가게 follow).
      astro.config.mjs 의 sitemap filter 가 같은 기준(>=2)으로 이미 제외하고 있으나,
      sitemap 제외만으로는 색인을 막지 못한다 — 글 하단 태그 링크로 크롤이 도달하기 때문.
      2026-08-30 실측: 태그 449개 중 318개가 thin, 그중 316개가 본문에서 링크돼 색인 가능 상태였음.
      임계값을 sitemap filter 와 어긋나게 바꾸면 두 기준이 갈리니 함께 고칠 것. */}
  noindex={posts.length < 2}
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <nav class="breadcrumb" aria-label="breadcrumb">
    <ol>
      <li><a href={withBase('/')}>{SITE_NAME}</a></li>
      <li><span aria-current="page">#{tag}</span></li>
    </ol>
  </nav>

  <div class="tag-hero">
    <span class="tag-badge">#{tag}</span>
    <h1>{tag}</h1>
    <p class="count">글 {posts.length}편</p>
  </div>

  <ul class="card-list">
    {posts.map((post) => (
      <li>
        <a class="card" href={withBase(`/posts/${post.id}/`)}>
          <span class="category">{post.data.category}</span>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="card-meta">
            <time datetime={post.data.publishedDate.toISOString().slice(0, 10)}>
              {post.data.publishedDate.toLocaleDateString('ko-KR')}
            </time>
            <span aria-hidden="true">·</span>
            <span>📖 약 {readingMinutes(post.body)}분</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <a class="back-link" href={withBase('/')}>← 전체 글 보기</a>
</BaseLayout>

<style>
  .tag-hero {
    margin: 28px 0 4px;
    text-align: center;
  }
  .tag-badge {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 4px 14px;
    border-radius: 999px;
  }
  .tag-hero h1 {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 10px 0 4px;
    color: var(--ink);
  }
  .count {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0 0 8px;
  }
</style>
