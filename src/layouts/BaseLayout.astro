---
import '../styles/global.css';
import {
  SITE_NAME,
  SITE_LOCALE,
  ADSENSE_CLIENT,
  GSC_VERIFICATION,
} from '../consts';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** 검색 색인 제외(404 등 유틸리티 페이지). true면 robots를 noindex로 출력. */
  noindex?: boolean;
}

const { title, description, ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('/og-default.png'), Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* iOS Safari가 본문의 숫자(금리 %·연도·"1,000만 원" 등)를 전화번호로
        오인해 파란 링크로 바꾸는 것 방지. 숫자 많은 경제 콘텐츠에 필수. */}
    <meta name="format-detection" content="telephone=no" />
    {/* 모바일 브라우저 주소창을 브랜드 컬러로(--accent) + 라이트 스킴 명시
        (다크모드 브라우저에서 흰 배경 사이트의 폼 컨트롤 색 뒤틀림 방지) */}
    <meta name="theme-color" content="#c2410c" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href={withBase('/favicon-cat.png')} />
    <link rel="apple-touch-icon" href={withBase('/favicon-cat.png')} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    {/* 검색 노출 최적화: 큰 이미지 미리보기(Google 검색·Discover에서 대표 썸네일
        크게 노출 → CTR↑) + 스니펫/영상 미리보기 길이 제한 해제. index,follow 명시.
        단, noindex 페이지(404 등)는 색인에서 제외하고 링크만 따라가게 한다. */}
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, follow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />

    {/* Google Search Console 소유확인 (consts.ts에 토큰 넣으면 노출) */}
    {GSC_VERIFICATION && (
      <meta name="google-site-verification" content={GSC_VERIFICATION} />
    )}

    <!-- Open Graph (SEO / 공유 미리보기) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE_NAME} />

    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={withBase('/rss.xml')} />

    <!-- 폰트 CDN preconnect (렌더 차단 폰트 로딩 단축) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    {/* 한국어 가독성 폰트 (Pretendard).
        dynamic-subset 빌드: 각 글자 범위를 unicode-range로 쪼개 두어, 그 페이지에
        실제로 쓰인 글자의 서브셋 woff2만 내려받는다(전체 한글 글리프 대량 다운로드 방지).
        family명은 그대로 'Pretendard', font-display:swap 내장이라 FOIT 없이 즉시 렌더. */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.min.css"
    />

    {/* 페이지별 구조화 데이터(JSON-LD) 등 추가 head 요소 주입 슬롯 */}
    <slot name="head" />

    {/* AdSense: consts.ts ADSENSE_CLIENT 채우면 자동 삽입 (승인 전엔 미노출) */}
    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">본문 바로가기</a>
    <header class="site-header">
      <div class="wrap">
        <a href={withBase('/')} class="logo">
        <img src={withBase('/mascot/logo.png')} alt="" class="logo__cat" width="34" height="34" />
        <span>옳은경제</span>
      </a>
        <span class="tagline">복잡한 경제, 바른 방향을 짚어주는</span>
      </div>
    </header>

    <main id="main-content" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav class="footer-nav" aria-label="사이트 정보">
          <a href={withBase('/about/')}>소개</a>
          <span aria-hidden="true">·</span>
          <a href={withBase('/privacy/')}>개인정보처리방침</a>
        </nav>
        <div class="footer-copy">© {new Date().getFullYear()} 옳은경제 · 글린트프로젝트</div>
      </div>
    </footer>
  </body>
</html>
